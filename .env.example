# Escalate - Slack Integration Secrets
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Required: Slack Bot User OAuth Token (starts with xoxb-)
ESCALATE_SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Required: Slack App-Level Token for Socket Mode (starts with xapp-)
ESCALATE_SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: OpenAI API key for voice note transcription (Whisper)
# ESCALATE_OPENAI_API_KEY=sk-your-openai-key-here
